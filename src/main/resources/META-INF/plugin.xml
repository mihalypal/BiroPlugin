        <product id="IC" since-build="233" until-build="251.*"/>
        <product id="IU" since-build="233" until-build="251.*"/>
        <product id="PC" since-build="233" until-build="251.*"/>
        <product id="PY" since-build="233" until-build="251.*"/>
        <product id="CL" since-build="233" until-build="251.*"/>
        <product id="WS" since-build="233" until-build="251.*"/>
        <product id="PS" since-build="233" until-build="251.*"/>
